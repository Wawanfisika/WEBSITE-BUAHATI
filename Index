    /**
     * SISTEM ROUTING & NAVIGASI SPA
     */
    function navigateTo(page, subSection = '') {
      // Pastikan keluar dari tampilan admin jika menuju halaman publik
      document.getElementById('adminMainView').classList.add('hidden');
      document.getElementById('publicMainView').classList.remove('hidden');
      document.getElementById('publicFooter').classList.remove('hidden');

      STATE.currentPage = page;
      STATE.currentSubTab = subSection;

      // Update indikator menu aktif
      document.querySelectorAll('.nav-item').forEach(btn => {
        const isMatch = btn.getAttribute('data-nav') === page;
        if (isMatch) {
          btn.classList.add('bg-buahati-light', 'text-buahati-bright', 'font-bold');
          btn.classList.remove('text-buahati-dark/80');
        } else {
          btn.classList.remove('bg-buahati-light', 'text-buahati-bright', 'font-bold');
          btn.classList.add('text-buahati-dark/80');
        }
      });

      // Update Breadcrumb
      const pageTitles = {
        beranda: 'Beranda',
        profil: 'Profil Sekolah',
        akademik: 'Akademik & Kurikulum',
        berita: 'Berita & Pengumuman',
        galeri: 'Galeri Sekolah',
        prestasi: 'Prestasi Siswa',
        fasilitas: 'Fasilitas Sekolah',
        psb: 'PSB Online (Penerimaan Siswa Baru)',
        faq: 'FAQ & Unduhan Dokumen',
        kontak: 'Hubungi Kami'
      };

      const bcBar = document.getElementById('breadcrumbBar');
      if (page === 'beranda') {
        bcBar.classList.add('hidden');
      } else {
        bcBar.classList.remove('hidden');
        document.getElementById('breadcrumbCurrentPage').textContent = pageTitles[page] || 'Halaman Tidak Ditemukan (404)';
      }

      const container = document.getElementById('publicMainView');
      switch (page) {
        case 'beranda': container.innerHTML = renderBerandaPage(); break;
        case 'profil': container.innerHTML = renderProfilPage(); break;
        case 'akademik': container.innerHTML = renderAkademikPage(); break;
        case 'berita': container.innerHTML = renderBeritaPage(); break;
        case 'galeri': container.innerHTML = renderGaleriPage(); break;
        case 'prestasi': container.innerHTML = renderPrestasiPage(); break;
        case 'fasilitas': container.innerHTML = renderFasilitasPage(); break;
        case 'psb':
          if (subSection === 'cek-status') STATE.psbActiveTab = 'status';
          else if (subSection === 'daftar') STATE.psbActiveTab = 'form';
          container.innerHTML = renderPSBPage();
          break;
        case 'faq': container.innerHTML = renderFAQPage(); break;
        case 'kontak': container.innerHTML = renderKontakPage(); break;
        default: container.innerHTML = render404Page(); break;
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

