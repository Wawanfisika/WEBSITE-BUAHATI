    async function handleAdminLoginSubmit(e) {
      e.preventDefault();
      const u = document.getElementById('adminLoginUsername').value.trim();
      const p = document.getElementById('adminLoginPassword').value;
      const btn = document.getElementById('adminLoginSubmitBtn');
      btn.disabled = true;
      btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Memverifikasi Kredensial...`;

      try {
        const res = await callServer('adminLogin', u, p);
        if (!res || !res.success) {
          document.getElementById('adminMainView').innerHTML = renderAdminLoginView(res ? res.message : 'Login gagal.');
          return;
        }
        STATE.adminSessionToken = res.sessionToken;
        STATE.adminUser = res.user;
        sessionStorage.setItem('SMAIT_ADMIN_TOKEN', res.sessionToken);
        showToast('Selamat datang, ' + res.user.full_name + '!', 'success');
        await openAdminPortal();
      } catch (err) {
        document.getElementById('adminMainView').innerHTML = renderAdminLoginView(err.message);
      }
    }

