      callServer('incrementNewsView', item.id);

      const shareText = encodeURIComponent(`${item.title} - SMAIT Buahati Islamic School Mamuju`);
      const shareUrl = encodeURIComponent(window.location.href);

      openUniversalModal(item.type || 'Detail Berita & Pengumuman', `
        <div class="space-y-5">
          <div class="rounded-2xl overflow-hidden max-h-80 bg-buahati-light">
            <img src="${esc(item.image_url)}" alt="${esc(item.title)}" class="w-full h-full object-cover" />
