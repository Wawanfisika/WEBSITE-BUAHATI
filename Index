          doc_prestasi_url: p.doc_prestasi_file ? 'Sertifikat Terunggah (Terproteksi)' : 'Belum Diunggah',
          doc_verification_status: 'Menunggu Verifikasi Panitia',
          selection_status: 'MENUNGGU SELEKSI',
          admin_notes: 'Pendaftaran berhasil diterima sistem. Silakan simpan Nomor Pendaftaran Anda.',
          created_at: new Date().toISOString(),
          updated_at: new Date().toISOString()
        };
        db.psb.unshift(newRec);
        saveLocalDB(db);
        return { success: true, ...newRec, message: 'Alhamdulillah, pendaftaran PSB berhasil disimpan!' };
      }
      if (fnName === 'checkPSBStatus') {
        const reg = String(args[0] || '').trim().toUpperCase();
        const nisn = String(args[1] || '').trim();
        const found = db.psb.find(r => String(r.reg_number).toUpperCase() === reg && String(r.nisn) === nisn);
        if (!found) return { success: false, message: 'Data tidak ditemukan. Pastikan Nomor Pendaftaran dan NISN sudah sesuai.' };
        return {
          success: true,
          data: {
            reg_number: found.reg_number,
            nisn: found.nisn.substring(0, 3) + '****' + found.nisn.slice(-3),
            full_name: found.full_name,
            origin_school: found.origin_school,
            choice_program: found.choice_program,
            achievement_track: found.achievement_track,
            doc_verification_status: found.doc_verification_status,
            selection_status: found.selection_status,
            admin_notes: found.admin_notes,
            updated_at: found.updated_at
          }
        };
      }
      if (fnName === 'submitContactMessage') {
        const m = args[0];
        db.pesanKontak.unshift({
          id: 'MSG-' + Date.now(),
          sender_name: m.sender_name,
          sender_email: m.sender_email || '-',
          sender_phone: m.sender_phone || '-',
          subject: m.subject || 'Pertanyaan Umum',
          message: m.message,
          status: 'Belum Dibaca',
          admin_reply_note: '',
          created_at: new Date().toISOString()
        });
        saveLocalDB(db);
        return { success: true, message: 'Terima kasih! Pesan Anda telah tersimpan dan akan segera ditindaklanjuti.' };
      }
      if (fnName === 'adminLogin') {
        const u = String(args[0] || '').trim().toLowerCase();
        const p = String(args[1] || '');
        const found = db.users.find(x => x.username.toLowerCase() === u && x.status === 'Aktif');
        if (!found || (found._pass && found._pass !== p)) {
          return { success: false, message: 'Username atau password tidak sesuai.' };
        }
        found.last_login = new Date().toISOString();
        db.activityLogs.unshift({ id: 'LOG-' + Date.now(), timestamp: new Date().toISOString(), username: found.username, role: found.role, action: 'LOGIN_SUCCESS', module: 'Auth', details: 'Login berhasil ke Dashboard Admin' });
        saveLocalDB(db);
        const token = 'LOCAL_TOKEN_' + found.id;
        sessionStorage.setItem('SMAIT_LOCAL_USER', JSON.stringify(found));
        return { success: true, sessionToken: token, user: found };
      }
      if (fnName === 'adminLogout') {
        sessionStorage.removeItem('SMAIT_LOCAL_USER');
        return { success: true };
      }
      if (fnName === 'getAdminDashboardData') {
        const userRaw = sessionStorage.getItem('SMAIT_LOCAL_USER');
        const currentUser = userRaw ? JSON.parse(userRaw) : db.users[0];
        return {
          success: true,
          currentUser: currentUser,
          spreadsheetUrl: '#mode-pratinjau-lokal-aktif',
          settings: db.settings,
          users: db.users,
          psb: db.psb,
          berita: db.berita,
          galeri: db.galeri,
          guruTendik: db.guruTendik,
          prestasi: db.prestasi,
          fasilitas: db.fasilitas,
          programUnggulan: db.programUnggulan,
          agenda: db.agenda,
          testimoni: db.testimoni,
          faq: db.faq,
          dokumen: db.dokumen,
          pesanKontak: db.pesanKontak,
          activityLogs: db.activityLogs,
          visitorStats: db.visitorStats
        };
      }
      if (fnName === 'adminSaveSettingsBatch') {
        Object.assign(db.settings, args[1]);
        db.activityLogs.unshift({ id: 'LOG-' + Date.now(), timestamp: new Date().toISOString(), username: 'admin', role: 'Super Admin', action: 'UPDATE_SETTINGS', module: 'Settings', details: 'Memperbarui pengaturan website' });
        saveLocalDB(db);
        return { success: true, message: 'Pengaturan berhasil disimpan dan diterapkan.' };
      }
      if (fnName === 'adminSaveRecord') {
        const moduleMap = {
          Berita: 'berita', Galeri: 'galeri', GuruTendik: 'guruTendik', Prestasi: 'prestasi',
          Fasilitas: 'fasilitas', ProgramUnggulan: 'programUnggulan', Agenda: 'agenda',
          Testimoni: 'testimoni', FAQ: 'faq', Dokumen: 'dokumen', PSB_Pendaftar: 'psb', PesanKontak: 'pesanKontak'
        };
        const key = moduleMap[args[1]];
        const rec = args[2];
        if (!rec.id) {
          rec.id = args[1].substring(0, 3).toUpperCase() + '-' + Date.now();
          if (args[1] === 'Berita' && !rec.published_at) rec.published_at = new Date().toISOString().substring(0, 10);
          db[key].unshift(rec);
        } else {
          const idx = db[key].findIndex(x => String(x.id) === String(rec.id));
          if (idx > -1) db[key][idx] = Object.assign({}, db[key][idx], rec);
          else db[key].unshift(rec);
        }
        db.activityLogs.unshift({ id: 'LOG-' + Date.now(), timestamp: new Date().toISOString(), username: 'admin', role: 'Super Admin', action: 'SAVE_RECORD', module: args[1], details: 'Menyimpan data pada modul ' + args[1] });
        saveLocalDB(db);
        return { success: true, message: 'Data berhasil disimpan.' };
      }
      if (fnName === 'adminDeleteRecord') {
        const moduleMap = {
          Berita: 'berita', Galeri: 'galeri', GuruTendik: 'guruTendik', Prestasi: 'prestasi',
          Fasilitas: 'fasilitas', ProgramUnggulan: 'programUnggulan', Agenda: 'agenda',
          Testimoni: 'testimoni', FAQ: 'faq', Dokumen: 'dokumen', PSB_Pendaftar: 'psb', PesanKontak: 'pesanKontak', Users: 'users'
        };
        const key = moduleMap[args[1]];
        db[key] = db[key].filter(x => String(x.id) !== String(args[2]));
        db.activityLogs.unshift({ id: 'LOG-' + Date.now(), timestamp: new Date().toISOString(), username: 'admin', role: 'Super Admin', action: 'DELETE_RECORD', module: args[1], details: 'Menghapus data ID ' + args[2] });
        saveLocalDB(db);
        return { success: true, message: 'Data berhasil dihapus.' };
      }
      if (fnName === 'adminChangeOwnCredentials') {
        const newU = String(args[1] || '').trim().toLowerCase();
        const curP = String(args[2] || '');
        const newP = String(args[3] || '');
        const uObj = db.users[0];
        if (uObj._pass && uObj._pass !== curP) return { success: false, message: 'Password saat ini tidak sesuai.' };
        uObj.username = newU;
        if (newP) uObj._pass = newP;
        saveLocalDB(db);
        return { success: true, username: newU, message: 'Username dan password berhasil diperbarui!' };
      }
      if (fnName === 'adminSaveUserAccount') {
        const p = args[1];
        if (p.id) {
          const idx = db.users.findIndex(u => u.id === p.id);
          if (idx > -1) {
            db.users[idx].username = p.username;
            db.users[idx].full_name = p.full_name;
            db.users[idx].role = p.role;
            db.users[idx].status = p.status;
            if (p.password) db.users[idx]._pass = p.password;
          }
        } else {
          db.users.push({
            id: 'USR-' + Date.now(),
            username: p.username,
            full_name: p.full_name,
            role: p.role,
            status: p.status || 'Aktif',
            _pass: p.password || 'Buahati123!',
            last_login: ''
          });
        }
        saveLocalDB(db);
        return { success: true, message: 'Data akun berhasil disimpan.' };
      }
      if (fnName === 'adminUploadPublicMedia') {
        const f = args[1];
        const dataUrl = 'data:' + f.mimeType + ';base64,' + f.base64;
        return { success: true, url: dataUrl, message: 'File berhasil diproses.' };
      }
      return { success: true };
    }

    /**
     * HELPER UTILITAS UI & SANITASI
     */
    function esc(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function formatParagraphs(text) {
      if (!text) return '';
      return String(text).split('\n').filter(line => line.trim() !== '').map(line =>
        `<p class="mb-2.5 leading-relaxed">${esc(line)}</p>`
      ).join('');
    }

    function formatListItems(text) {
      if (!text) return '';
      return String(text).split('\n').filter(line => line.trim() !== '').map(line => {
        const cleaned = line.replace(/^[0-9]+[.)]\s*/, '').replace(/^[•\-*]\s*/, '');
        return `<li class="flex items-start gap-3"><span class="w-6 h-6 rounded-full bg-buahati-bright/15 text-buahati-bright flex items-center justify-center text-xs font-bold shrink-0 mt-0.5"><i class="fa-solid fa-check"></i></span><span class="text-buahati-dark/85 leading-relaxed">${esc(cleaned)}</span></li>`;
      }).join('');
    }

    function showToast(message, type = 'success') {
      const container = document.getElementById('toastContainer');
      const id = 'toast-' + Date.now();
      const bgClass = type === 'error'
        ? 'bg-red-600 text-white'
        : type === 'info'
        ? 'bg-buahati-dark text-white'
        : 'bg-buahati-bright text-white';
      const iconClass = type === 'error'
        ? 'fa-circle-exclamation'
        : type === 'info'
        ? 'fa-circle-info'
        : 'fa-circle-check';

      const el = document.createElement('div');
      el.id = id;
      el.className = `${bgClass} px-4 py-3.5 rounded-2xl shadow-2xl flex items-start gap-3 pointer-events-auto animate-fade-up border border-white/20`;
      el.innerHTML = `
        <i class="fa-solid ${iconClass} text-lg mt-0.5"></i>
        <div class="flex-1 text-xs sm:text-sm font-semibold leading-snug">${esc(message)}</div>
        <button onclick="document.getElementById('${id}').remove()" class="text-white/80 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      `;
      container.appendChild(el);
      setTimeout(() => {
        const target = document.getElementById(id);
        if (target) target.remove();
      }, 4500);
    }

