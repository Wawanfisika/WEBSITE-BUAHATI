    async function handleContactFormSubmit(e) {
      e.preventDefault();
      const form = e.target;
      const btn = document.getElementById('contactSubmitBtn');
      const orig = btn.innerHTML;
      try {
        btn.disabled = true;
        btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Mengirim...`;
        const res = await callServer('submitContactMessage', {
          sender_name: form.sender_name.value.trim(),
          sender_phone: form.sender_phone.value.trim(),
          sender_email: form.sender_email.value.trim(),
          subject: form.subject.value,
          message: form.message.value.trim()
        });
        if (!res || !res.success) throw new Error(res ? res.message : 'Gagal mengirim pesan.');
        showToast(res.message, 'success');
        form.reset();
      } catch (err) {
        showToast(err.message, 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = orig;
      }
    }

