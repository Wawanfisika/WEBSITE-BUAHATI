    /**
     * HELPER SIMPAN FORM PENGATURAN BATCH (`Settings`)
     */
    async function handleSaveSettingsForm(e) {
      e.preventDefault();
      const form = e.target;
      const formData = new FormData(form);
      const map = {};
      for (const [k, v] of formData.entries()) {
        map[k] = v;
      }
      try {
        showToast('Menyimpan perubahan ke Google Spreadsheet...', 'info');
        const res = await callServer('adminSaveSettingsBatch', STATE.adminSessionToken, map);
        if (!res || !res.success) throw new Error(res ? res.message : 'Gagal menyimpan pengaturan.');
        Object.assign(STATE.adminData.settings, map);
        Object.assign(STATE.publicData.settings, map);
        applyBrandingAndChrome();
        showToast(res.message, 'success');
      } catch (err) {
        showToast(err.message, 'error');
      }
    }

    /**
     * HELPER UPLOAD FILE MEDIA KE GOOGLE DRIVE DARI FORM ADMIN
     */
    async function triggerDriveUploadToInput(fileInputId, targetUrlInputId) {
      const fileEl = document.getElementById(fileInputId);
      if (!fileEl || !fileEl.files || !fileEl.files[0]) {
        showToast('Pilih file gambar/PDF terlebih dahulu.', 'error');
        return;
      }
      try {
        showToast('Mengunggah file ke Google Drive...', 'info');
        const fileObj = await readFileAsBase64Obj(fileInputId);
        const res = await callServer('adminUploadPublicMedia', STATE.adminSessionToken, fileObj);
        if (!res || !res.success) throw new Error(res ? res.message : 'Gagal mengunggah file.');
        document.getElementById(targetUrlInputId).value = res.url;
        showToast('Berhasil diunggah! Jangan lupa klik Simpan Pengaturan/Data.', 'success');
      } catch (err) {
        showToast(err.message, 'error');
      }
    }

