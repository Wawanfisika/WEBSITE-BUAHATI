            <div class="flex items-center justify-between mb-3">
              <h3 class="font-extrabold text-sm text-buahati-dark uppercase">2. Pengelolaan Akun Administrator & Hak Akses (${users.length})</h3>
              <button onclick="openAdminUserModal()" class="px-3.5 py-1.5 rounded-xl bg-buahati-bright text-white font-bold">+ Tambah Akun Admin / Panitia</button>
            </div>
            <div class="overflow-x-auto rounded-2xl border border-buahati-light">
              <table class="w-full text-left border-collapse">
                <thead><tr class="bg-buahati-light"><th class="p-3">Username</th><th class="p-3">Nama Lengkap</th><th class="p-3">Peran (Role)</th><th class="p-3">Status</th><th class="p-3 text-right">Aksi</th></tr></thead>
                <tbody class="divide-y divide-buahati-light">
                  ${users.map(usr => `
                    <tr>
                      <td class="p-3 font-extrabold text-buahati-bright">@${esc(usr.username)}</td>
                      <td class="p-3 font-bold">${esc(usr.full_name)}</td>
                      <td class="p-3"><span class="px-2 py-0.5 rounded bg-buahati-light font-bold">${esc(usr.role)}</span></td>
                      <td class="p-3">${esc(usr.status)}</td>
                      <td class="p-3 text-right space-x-1">
                        <button onclick="openAdminUserModal('${esc(usr.id)}')" class="px-2.5 py-1 rounded bg-buahati-soft border font-bold">Edit</button>
