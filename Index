        const regNumber = 'PSB-BH-' + new Date().getFullYear() + '-' + String(db.psb.length + 1).padStart(4, '0');
        const newRec = {
          id: 'PSB-' + Date.now(),
          reg_number: regNumber,
          nisn: p.nisn,
          full_name: p.full_name,
          gender: p.gender,
          birth_place: p.birth_place,
          birth_date: p.birth_date,
          origin_school: p.origin_school,
          graduation_year: p.graduation_year,
          choice_program: p.choice_program,
          achievement_track: p.achievement_track,
          father_name: p.father_name,
          mother_name: p.mother_name,
          parent_phone: p.parent_phone,
          student_phone: p.student_phone,
          email: p.email,
          address: p.address,
