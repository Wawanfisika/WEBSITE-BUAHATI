    async function handleAdminUpdatePSBStatus(e, psbId) {
      e.preventDefault();
      const form = e.target;
      const payload = {
        id: psbId,
        doc_verification_status: form.doc_verification_status.value,
        selection_status: form.selection_status.value,
        admin_notes: form.admin_notes.value.trim()
      };
      const res = await callServer('adminSaveRecord', STATE.adminSessionToken, 'PSB_Pendaftar', payload);
      if (res && res.success) {
        showToast('Status pendaftar PSB berhasil diperbarui!', 'success');
        closeUniversalModal();
        await openAdminPortal();
      } else {
        showToast(res ? res.message : 'Gagal memperbarui status PSB.', 'error');
      }
    }

