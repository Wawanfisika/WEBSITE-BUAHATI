          doc_akta_url: p.doc_akta_file ? 'Dokumen Akta Terunggah (Terproteksi)' : 'Belum Diunggah',
          doc_rapor_url: p.doc_rapor_file ? 'Dokumen Rapor Terunggah (Terproteksi)' : 'Belum Diunggah',
