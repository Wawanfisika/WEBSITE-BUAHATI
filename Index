    function handleGlobalSearch(query) {
      const box = document.getElementById('globalSearchResults');
      const q = String(query || '').toLowerCase().trim();
      if (q.length < 2) {
        box.innerHTML = `<p class="text-xs text-center text-buahati-dark/60 py-6">Ketik minimal 2 huruf untuk mencari di Berita, Prestasi, Guru, Fasilitas, Agenda, atau FAQ.</p>`;
        return;
      }

      const hits = [];
      (STATE.publicData.berita || []).forEach(b => {
        if (String(b.title).toLowerCase().includes(q) || String(b.summary).toLowerCase().includes(q)) {
          hits.push({ badge: 'Berita & Pengumuman', title: b.title, desc: b.summary, action: `closeGlobalSearchModal(); openNewsDetailModal('${esc(b.id)}')` });
        }
      });
      (STATE.publicData.prestasi || []).forEach(p => {
        if (String(p.title).toLowerCase().includes(q) || String(p.student_name).toLowerCase().includes(q)) {
          hits.push({ badge: 'Prestasi Siswa', title: p.title, desc: `${p.result_rank} — ${p.student_name}`, action: `closeGlobalSearchModal(); navigateTo('prestasi')` });
        }
      });
      (STATE.publicData.guruTendik || []).forEach(g => {
        if (String(g.name).toLowerCase().includes(q) || String(g.subject).toLowerCase().includes(q) || String(g.position).toLowerCase().includes(q)) {
          hits.push({ badge: 'Guru & Tendik', title: g.name, desc: `${g.position} (${g.subject})`, action: `closeGlobalSearchModal(); navigateTo('profil')` });
        }
      });
      (STATE.publicData.fasilitas || []).forEach(f => {
        if (String(f.name).toLowerCase().includes(q) || String(f.description).toLowerCase().includes(q)) {
          hits.push({ badge: 'Fasilitas Sekolah', title: f.name, desc: f.description, action: `closeGlobalSearchModal(); navigateTo('fasilitas')` });
        }
      });
      (STATE.publicData.faq || []).forEach(f => {
        if (String(f.question).toLowerCase().includes(q) || String(f.answer).toLowerCase().includes(q)) {
          hits.push({ badge: 'FAQ', title: f.question, desc: f.answer, action: `closeGlobalSearchModal(); navigateTo('faq')` });
        }
      });

      if (hits.length === 0) {
        box.innerHTML = `<p class="text-xs text-center text-buahati-dark/60 py-6">Tidak ditemukan hasil untuk kata kunci "<strong>${esc(query)}</strong>".</p>`;
        return;
      }

      box.innerHTML = hits.map(h => `
        <div onclick="${h.action}" class="p-3.5 rounded-xl bg-buahati-soft hover:bg-buahati-light cursor-pointer border border-buahati-light transition">
          <span class="px-2 py-0.5 rounded bg-buahati-bright text-white text-[10px] font-bold uppercase">${esc(h.badge)}</span>
          <h4 class="font-bold text-sm text-buahati-dark mt-1">${esc(h.title)}</h4>
          <p class="text-xs text-buahati-dark/70 line-clamp-2 mt-0.5">${esc(h.desc)}</p>
        </div>
      `).join('');
    }

