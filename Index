            <div class="flex items-center justify-between mb-3">
              <h3 class="font-extrabold text-sm text-buahati-dark uppercase">4. Riwayat Aktivitas Administrator (Audit Log)</h3>
              <button onclick="exportModuleToExcel('activityLogs', 'Log_Aktivitas_Admin_SMAIT_Buahati')" class="px-3 py-1.5 rounded-xl bg-emerald-600 text-white font-bold">Ekspor Log ke Excel</button>
            </div>
            <div class="max-h-64 overflow-y-auto rounded-2xl border border-buahati-light">
              <table class="w-full text-left border-collapse">
                <thead><tr class="bg-buahati-light sticky top-0"><th class="p-2.5">Waktu</th><th class="p-2.5">User & Peran</th><th class="p-2.5">Aksi & Modul</th><th class="p-2.5">Detail Aktivitas</th></tr></thead>
                <tbody class="divide-y divide-buahati-light">
                  ${logs.map(l => `
                    <tr>
                      <td class="p-2.5 whitespace-nowrap text-[11px] text-buahati-dark/60">${esc(String(l.timestamp || '').substring(0, 19).replace('T', ' '))}</td>
                      <td class="p-2.5 font-bold">${esc(l.username)} (${esc(l.role)})</td>
                      <td class="p-2.5"><span class="px-2 py-0.5 rounded bg-buahati-soft text-buahati-bright font-bold">${esc(l.action)} • ${esc(l.module)}</span></td>
                      <td class="p-2.5">${esc(l.details)}</td>
