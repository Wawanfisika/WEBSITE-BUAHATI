    function openAdminUserModal(id = '') {
      const usr = (STATE.adminData.users || []).find(x => String(x.id) === String(id)) || {
        id: '', username: '', full_name: '', role: 'Admin Konten', status: 'Aktif'
      };
      openUniversalModal(id ? 'Edit Akun Pengguna' : 'Tambah Akun Pengguna Baru', `
        <form onsubmit="handleAdminSaveUser(event)" class="space-y-3 text-xs">
          <input type="hidden" name="id" value="${esc(usr.id)}" />
          <div><label class="font-bold block mb-1">Username *</label><input type="text" name="username" value="${esc(usr.username)}" required class="w-full px-3 py-2 rounded-xl border" /></div>
          <div><label class="font-bold block mb-1">Nama Lengkap *</label><input type="text" name="full_name" value="${esc(usr.full_name)}" required class="w-full px-3 py-2 rounded-xl border" /></div>
          <div class="grid grid-cols-2 gap-2">
            <div><label class="font-bold block mb-1">Peran & Hak Akses</label><select name="role" class="w-full px-3 py-2 rounded-xl border bg-white">${['Super Admin', 'Admin Konten', 'Panitia PSB'].map(r => `<option value="${r}" ${usr.role === r ? 'selected' : ''}>${r}</option>`).join('')}</select></div>
            <div><label class="font-bold block mb-1">Status Akun</label><select name="status" class="w-full px-3 py-2 rounded-xl border bg-white"><option value="Aktif" ${usr.status === 'Aktif' ? 'selected' : ''}>Aktif</option><option value="Nonaktif" ${usr.status === 'Nonaktif' ? 'selected' : ''}>Nonaktif</option></select></div>
          </div>
          <div><label class="font-bold block mb-1">Password ${id ? '(Kosongkan jika tidak ingin mengubah password)' : '(Wajib minimal 8 karakter) *'}</label><input type="password" name="password" ${id ? '' : 'required'} class="w-full px-3 py-2 rounded-xl border" /></div>
          <div class="flex justify-end pt-2"><button type="submit" class="px-5 py-2 rounded-xl bg-buahati-bright text-white font-extrabold">Simpan Akun</button></div>
        </form>
      `);
    }

    async function handleAdminChangeCredentials(e) {
      e.preventDefault();
      const f = e.target;
      const res = await callServer('adminChangeOwnCredentials', STATE.adminSessionToken, f.new_username.value.trim(), f.current_password.value, f.new_password.value);
      if (res && res.success) {
        showToast(res.message, 'success');
        f.reset();
        await openAdminPortal();
      } else {
        showToast(res ? res.message : 'Gagal memperbarui kredensial.', 'error');
      }
    }

    async function handleAdminSaveUser(e) {
      e.preventDefault();
      const f = e.target;
      const res = await callServer('adminSaveUserAccount', STATE.adminSessionToken, {
        id: f.id.value,
        username: f.username.value.trim(),
        full_name: f.full_name.value.trim(),
        role: f.role.value,
        status: f.status.value,
        password: f.password.value
      });
      if (res && res.success) {
        showToast(res.message, 'success');
        closeUniversalModal();
        await openAdminPortal();
      } else {
        showToast(res ? res.message : 'Gagal menyimpan akun.', 'error');
      }
    }

    /**
     * GENERIC SAVE, DELETE & EXPORT EXCEL (.CSV) HANDLERS UNTUK ADMIN
     */
    async function handleAdminSaveGeneric(e, moduleName) {
      e.preventDefault();
      const form = e.target;
      const fd = new FormData(form);
      const obj = {};
      for (const [k, v] of fd.entries()) obj[k] = v;

      const res = await callServer('adminSaveRecord', STATE.adminSessionToken, moduleName, obj);
      if (res && res.success) {
        showToast(res.message, 'success');
        closeUniversalModal();
        const pub = await callServer('getPublicBootstrapData');
        if (pub && pub.success) STATE.publicData = pub;
        await openAdminPortal();
      } else {
        showToast(res ? res.message : 'Gagal menyimpan data.', 'error');
      }
    }

    async function handleAdminDelete(moduleName, recordId) {
      if (!confirm('Apakah Anda yakin ingin menghapus data ini secara permanen dari database?')) return;
      const res = await callServer('adminDeleteRecord', STATE.adminSessionToken, moduleName, recordId);
      if (res && res.success) {
        showToast(res.message, 'success');
        const pub = await callServer('getPublicBootstrapData');
        if (pub && pub.success) STATE.publicData = pub;
        await openAdminPortal();
      } else {
        showToast(res ? res.message : 'Gagal menghapus data.', 'error');
      }
    }

    function exportModuleToExcel(dataKey, filenamePrefix) {
      const rows = (STATE.adminData && STATE.adminData[dataKey]) || [];
      if (!rows.length) {
        showToast('Tidak ada data untuk diekspor.', 'info');
        return;
      }
      const headers = Object.keys(rows[0]).filter(h => h !== '_pass');
      const csvLines = [
        headers.join(','),
        ...rows.map(r => headers.map(h => `"${String(r[h] ?? '').replace(/"/g, '""')}"`).join(','))
      ];
      const blob = new Blob(['\uFEFF' + csvLines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${filenamePrefix}_${new Date().toISOString().substring(0, 10)}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      showToast('File Excel (.CSV) berhasil diunduh!', 'success');
    }

    /**
     * INISIALISASI APLIKASI SAAT HALAMAN DIMUAT
     */
    window.addEventListener('scroll', () => {
      const btn = document.getElementById('backToTopBtn');
      if (btn) btn.classList.toggle('hidden', window.scrollY < 320);
    });

    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openGlobalSearchModal();
      }
      if (e.key === 'Escape') {
        closeGlobalSearchModal();
        closeUniversalModal();
      }
    });

    document.addEventListener('DOMContentLoaded', async () => {
      // Tampilkan data default terlebih dahulu agar pemuatan instan & responsif
      applyBrandingAndChrome();
      navigateTo('beranda');

      // Sinkronkan dengan database Google Spreadsheet
      try {
        const res = await callServer('getPublicBootstrapData');
        if (res && res.success) {
          STATE.publicData = res;
          applyBrandingAndChrome();
          if (document.getElementById('adminMainView').classList.contains('hidden')) {
            navigateTo(STATE.currentPage, STATE.currentSubTab);
          }
        }
      } catch (err) {
        console.warn('Menggunakan data pratinjau lokal:', err);
      }
    });
  </script>
